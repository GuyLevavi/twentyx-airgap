# Shared git settings -- a link into the repo; edit it here and commit.
# Your identity goes in ~/.gitconfig, a real file the link scripts create
# empty: `git config --global` writes there whenever it exists, so it never
# writes through this link.
[init]
	defaultBranch = main
[pull]
	rebase = true
[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
