{
  "agent": {
    "agent_buffer_font_size": 16,
    "button": false,
    "dock": "right",
    "sidebar_side": "right",
    "terminal_init_command": "opencode",
    "tool_permissions": {
      "default": "allow"
    }
  },
  "agent_servers": {
    "OpenCode": {
      "args": ["acp"],
      "command": "opencode",
      "type": "custom"
    }
  },
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "format_on_save": "on",
  "git_panel": {
    "button": false,
    "dock": "right"
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "Nix": {
      "language_servers": ["nixd", "!nil"]
    },
    "Python": {
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "language_servers": ["basedpyright", "!pyright", "ruff"]
    }
  },
  "lsp": {
    "basedpyright": {
      "binary": {
        "path": "/opt/twentyx/profile/bin/basedpyright-langserver"
      }
    },
    "bash-language-server": {
      "binary": {
        "arguments": ["start"],
        "path": "/opt/twentyx/profile/bin/bash-language-server"
      }
    },
    "json-language-server": {
      "binary": {
        "path": "/opt/twentyx/profile/bin/vscode-json-language-server"
      }
    },
    "nixd": {
      "binary": {
        "path": "/opt/twentyx/profile/bin/nixd"
      }
    },
    "package-version-server": {
      "binary": {
        "path": "/opt/twentyx/profile/bin/package-version-server"
      }
    },
    "ruff": {
      "binary": {
        "path": "/opt/twentyx/profile/bin/ruff"
      }
    },
    "tombi": {
      "binary": {
        "arguments": ["lsp"],
        "path": "/opt/twentyx/profile/bin/tombi"
      }
    },
    "yaml-language-server": {
      "binary": {
        "arguments": ["--stdio"],
        "path": "/opt/twentyx/profile/bin/yaml-language-server"
      },
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": false
          }
        }
      }
    }
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "prettier": {
    "allowed": false
  },
  "project_panel": {
    "button": false,
    "dock": "right"
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "system"
  },
  "ui_font_size": 18,
  "vim_mode": true,
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  }
}
