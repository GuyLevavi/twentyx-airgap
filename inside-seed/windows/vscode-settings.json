// VS Code settings for the airgap Windows client — shipped in .#windows-kit.
//
// Copy to %APPDATA%\Code\User\settings.json (UNPACK.ps1 does it for you;
// merge into an existing file if you have one — a real file always wins).
// Everything here exists to keep the client honest in the gap:
//   - update.mode none: the client must stay at the kit installer's version,
//     because the WSL side pre-seeds the remote server for that EXACT commit.
//     An updated client would demand a server it cannot download.
//   - extension auto-update off, same reason.
//   - schema downloads off: JSON/YAML validation must not stall on a fetch.
//   - telemetry off: no phone-home attempts to time out against.
//
// The language-server PINS live in the remote machine settings, a dotfile
// linked to ~/.vscode-server/data/Machine/settings.json in the distro
// (ruff.path and nix.serverPath point at the same closure binaries Zed and
// nvim use). This file only carries client bits; the extensions are seeded
// inside the distro by its vscode-extensions service.
{
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "workbench.startupEditor": "none",
  "json.schemaDownload.enable": false,
  "yaml.schemaStore.enable": false,
  "git.autofetch": false,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  // Served by the kit's vscode\vsix\enkia.tokyo-night.vsix.
  "workbench.colorTheme": "Tokyo Night"
}
