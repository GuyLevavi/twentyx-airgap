#!/usr/bin/env bash
# Summary: airgap workspace toolchain dispatcher
#
# Omarchy-style dispatcher: `airgap <group> <action>` resolves to
# libexec/airgap-<group>-<action>, falling back to libexec/airgap-<group>.
#
# Each subcommand declares itself with a `# Summary:` line on line 2, which is
# what `airgap commands` reads. Keep that contract.
set -euo pipefail

AIRGAP_ROOT="${AIRGAP_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export AIRGAP_ROOT
LIBEXEC="$AIRGAP_ROOT/libexec"

summary_of() { sed -n '2s/^# Summary: //p' "$1" 2>/dev/null; }

list_commands() {
    local f name
    printf '%s\n' "airgap <command> [args]"
    printf '\n'
    for f in "$LIBEXEC"/airgap-*; do
        [ -f "$f" ] && [ -x "$f" ] || continue
        name="${f##*/airgap-}"
        # Skip sourced helpers (*.sh) and internal-only entry points.
        case "$name" in *.sh|entrypoint|vendor-verify) continue ;; esac
        printf '  %-18s %s\n' "${name//-/ }" "$(summary_of "$f")"
    done
}

usage() {
    list_commands
    cat <<'EOF'

  commands           list all commands
  help               this message

Layers (read `airgap doctor` to see them resolved):
  $AIRGAP_ROOT       packaged defaults, never edit at runtime
  $AIRGAP_STATE      persistent overrides on the PVC
  $HOME              ephemeral, rebuilt from the two above on every start
EOF
}

resolve() {
    # Longest match first: `pi run` prefers airgap-pi-run over airgap-pi.
    local a="${1:-}" b="${2:-}"
    if [ -n "$b" ] && [ -x "$LIBEXEC/airgap-$a-$b" ]; then
        printf '%s\n2' "$LIBEXEC/airgap-$a-$b"
    elif [ -n "$a" ] && [ -x "$LIBEXEC/airgap-$a" ]; then
        printf '%s\n1' "$LIBEXEC/airgap-$a"
    else
        return 1
    fi
}

main() {
    case "${1:-help}" in
        help|--help|-h) usage; return 0 ;;
        commands)       list_commands; return 0 ;;
        version)        cat "$AIRGAP_ROOT/VERSION" 2>/dev/null || echo "dev"; return 0 ;;
    esac

    local found shift_by
    if ! found="$(resolve "${1:-}" "${2:-}")"; then
        printf 'airgap: unknown command: %s\n\n' "$*" >&2
        usage >&2
        return 127
    fi
    shift_by="$(printf '%s' "$found" | tail -1)"
    found="$(printf '%s' "$found" | head -1)"
    shift "$shift_by"
    exec "$found" "$@"
}

main "$@"
