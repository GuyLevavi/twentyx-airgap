# syntax=docker/dockerfile:1.7
#
# The ONLY thing left that needs a container to build.
#
# Nix computes the rest of the toolchain, so this stage exists purely because
# pi ships as an npm package and npm must run somewhere with a registry. It
# produces a filesystem tree at /out, exported as a tar and crane-appended by
# assemble.sh. It never touches a pytorch base.
#
#   docker buildx build -f docker/Containerfile.node \
#     --build-arg BASE_IMAGE=$INTERNAL_REGISTRY/base-slim:latest \
#     --build-arg NPM_REGISTRY=$ARTIFACTORY_URL/api/npm/npm-local/ \
#     --target export -o type=tar,dest=dist/node-layer.tar .
#
# Requires dist/nix-layer.tar.gz in the build context: node comes from the Nix
# closure now, so the two layers are built against the same interpreter that
# will run them in the pod.

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS build

ARG NPM_REGISTRY

# Unpack the Nix layer into the BUILD container only. It is not copied into
# /out -- assemble.sh appends it separately, so it stays one blob that both
# image flavors share rather than being duplicated inside this one.
#
# It must land at literal /nix: every Nix-built binary names its ELF
# interpreter by absolute store path, so an unpack anywhere else produces a
# node that cannot exec.
COPY dist/nix-layer.tar.gz /tmp/nix-layer.tar.gz
RUN tar -xzf /tmp/nix-layer.tar.gz -C / && rm /tmp/nix-layer.tar.gz

ENV PATH=/opt/airgap/profile/bin:${PATH}

# Prove the closure survived the round trip before spending a network call on
# npm. A broken interpreter path fails here, in CI, rather than in a pod.
RUN node --version && npm --version

# --- npm globals (changes: monthly) ---------------------------------------
# pi is JS on top of that node, which is what makes it immune to the x86-64
# microarchitecture segfault that killed the compiled OpenCode binary.
#
# --ignore-scripts: postinstall scripts are the one place an npm package can
# reach the network, and inside the gap that is a hang, not an error.
#
# The LSP servers that used to be installed here now come from the Nix closure
# (see nix/modules/nvim.nix), so this list is deliberately one entry long.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    mkdir -p /out/opt/airgap/node-globals && \
    npm config set registry "${NPM_REGISTRY}" && \
    npm install -g --ignore-scripts --prefix /out/opt/airgap/node-globals \
      @earendil-works/pi-coding-agent

# npm writes bin/ entries as relative symlinks and `#!/usr/bin/env node`
# shebangs, both of which resolve correctly once /opt/airgap/profile/bin is on
# PATH. Check it here rather than discovering it at pod start.
RUN test -e /out/opt/airgap/node-globals/bin/pi

# OpenShift assigns an arbitrary UID at runtime whose only guaranteed group is
# 0, so everything must be group-owned by 0 and group-readable.
RUN chgrp -R 0 /out && chmod -R g=u /out

# --- export stage: the tar contains ONLY the tree, rooted at / -------------
FROM scratch AS export
COPY --from=build /out/ /
