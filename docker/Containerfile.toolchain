# syntax=docker/dockerfile:1.7
#
# STAGE 1 -- build the airgap toolchain tree in a SLIM image.
#
# Output is a filesystem tree at /out, exported as a tarball and appended onto the
# fat internal bases by assemble.sh. This never touches a pytorch base.
#
#   docker build -f docker/Containerfile.toolchain \
#     --build-arg BASE_IMAGE=$INTERNAL_REGISTRY/base-slim:latest \
#     --cache-from type=registry,ref=$IMAGE:buildcache \
#     --cache-to   type=registry,ref=$IMAGE:buildcache,mode=max \
#     --target export -o type=tar,dest=toolchain.tar .
#
# Use the internal *slim* base so registries and CA certs are already configured.

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG NPM_REGISTRY
ARG PIP_INDEX_URL

# Everything lands under /out, which becomes the appended layer.
RUN mkdir -p /out/opt/airgap /out/usr/local/bin

# --- vendored static binaries (changes: monthly) --------------------------
# Fetched from internal Artifactory generic-local by scripts/fetch-vendor.sh,
# or restored from the transferred tarball. Never from the internet.
COPY vendor/manifest.toml     /out/opt/airgap/vendor/manifest.toml
COPY vendor/CHECKSUMS.sha256  /tmp/vendor/CHECKSUMS.sha256
COPY vendor/bin/              /tmp/vendor/bin/
COPY libexec/airgap-vendor-verify /usr/local/bin/airgap-vendor-verify
# Fails the build on a corrupted physical transfer, rather than shipping an
# image that segfaults in a pod three days later.
RUN airgap-vendor-verify /tmp/vendor && \
    install -m 0755 /tmp/vendor/bin/* /out/usr/local/bin/

# --- node runtime + npm globals (changes: monthly) ------------------------
# pi ships as JS via npm: CPU-microarchitecture-agnostic, which sidesteps the
# x86-64-v2 baseline segfaults that bit the compiled OpenCode binary.
ARG NODE_VERSION=22.11.0
COPY vendor/node-v${NODE_VERSION}-linux-x64.tar.xz /tmp/node.tar.xz
RUN mkdir -p /out/usr/local && \
    tar -xJf /tmp/node.tar.xz -C /out/usr/local --strip-components=1 && \
    rm /tmp/node.tar.xz

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    export PATH=/out/usr/local/bin:$PATH && \
    npm config set registry "${NPM_REGISTRY}" && \
    npm install -g --ignore-scripts --prefix /out/usr/local \
      @earendil-works/pi-coding-agent \
      typescript typescript-language-server \
      yaml-language-server bash-language-server \
      dockerfile-language-server-nodejs

# --- neovim plugin pack (changes: monthly) --------------------------------
# Pre-resolved and lockfile-pinned. LazyVim never reaches the network at runtime.
COPY vendor/nvim-pack/ /out/opt/airgap/nvim-pack/

# --- code-server, newer than the base image's (changes: quarterly) --------
# Shipped as a whole tree under /opt/airgap and placed ahead of /usr/bin on
# PATH. The base image is never modified, so reverting is a PATH change rather
# than a rebuild.
COPY vendor/code-server/ /out/opt/airgap/code-server/
RUN if [ -x /out/opt/airgap/code-server/bin/code-server ]; then \
      chmod -R g=u /out/opt/airgap/code-server; \
      # The bundled Node may target a newer microarchitecture than some cluster
      # CPUs -- the failure that segfaulted OpenCode. Catch it HERE, at build
      # time, rather than in a pod. Falls back to our baseline-safe Node.
      if ! /out/opt/airgap/code-server/lib/node --version >/dev/null 2>&1; then \
        echo "bundled node unusable; substituting vendored node"; \
        mv /out/opt/airgap/code-server/lib/node /out/opt/airgap/code-server/lib/node.orig && \
        cp /out/usr/local/bin/node /out/opt/airgap/code-server/lib/node; \
      fi; \
      /out/opt/airgap/code-server/bin/code-server --version; \
    fi

# --- vsix extensions for code-server (changes: quarterly) -----------------
# Installed with the CLI rather than unzipped by hand, so the extensions dir
# gets the layout and metadata code-server expects. Use the NEW code-server, so
# extensions are resolved against the version that will actually run them.
# airgap-bootstrap seeds this tree onto the PVC at runtime.
COPY vendor/vsix/ /tmp/vsix/
RUN if [ -n "$(ls -A /tmp/vsix 2>/dev/null)" ]; then \
      mkdir -p /out/opt/airgap/vscode-extensions && \
      CS=/out/opt/airgap/code-server/bin/code-server; \
      [ -x "$CS" ] || CS=code-server; \
      for f in /tmp/vsix/*.vsix; do \
        "$CS" --extensions-dir /out/opt/airgap/vscode-extensions \
              --install-extension "$f" --force; \
      done; \
    fi

# --- airgap dispatcher, configs, pi package (changes: HOURLY) -------------
# Dead last: a config edit invalidates only this layer.
COPY bin/     /out/opt/airgap/bin/
COPY libexec/ /out/opt/airgap/libexec/
COPY config/  /out/opt/airgap/config/
COPY pi/      /out/opt/airgap/pi/

# OpenShift assigns an arbitrary UID at runtime (observed: uid 10001, gid 0,
# plus a nameless supplementary group). Only GID 0 is guaranteed, so everything
# must be group-owned by 0 and group-writable.
#
# NOTE: we deliberately do NOT touch /etc/passwd or /etc/group here.
# Only /out becomes the appended layer, so a chmod on /etc would be silently
# discarded -- and shipping our own /etc/passwd would clobber whatever the
# pytorch base defines. See NOTES.md item 6: making them group-writable is a
# one-line change the BASE image owners must make. Until then,
# airgap-entrypoint degrades quietly and the `groups:` warning is cosmetic.
RUN chgrp -R 0 /out && chmod -R g=u /out && \
    mkdir -p /out/usr/local/bin && \
    ln -sf /opt/airgap/bin/airgap /out/usr/local/bin/airgap

# --- export stage: tarball contains ONLY the tree, rooted at / -------------
FROM scratch AS export
COPY --from=build /out/ /
