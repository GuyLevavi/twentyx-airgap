# Git holds TEXT ONLY. Everything binary is computed by Nix, not committed:
# the closure IS the manifest, so there is no blob list to keep in sync.
dist/
result
result-*
node_modules/
*.log
.DS_Store

# Written by scripts/nix-export.sh when it signs a transfer. Tracked
# deliberately? No: it is per-machine. nix/hosts/wsl.nix picks it up if present
# and falls back to require-sigs = false when it is absent.
cache-pubkey
ca-bundle.crt
