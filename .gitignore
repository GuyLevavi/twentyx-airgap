# Git holds TEXT ONLY. Everything binary is computed by Nix, not committed:
# the closure IS the manifest, so there is no blob list to keep in sync.
dist/
result
result-*
node_modules/
*.log
.DS_Store

ca-bundle.crt

# Per-machine WSL username (one word): each team member sets their own before
# building their tarball. See the username block in flake.nix.
wsl-username
