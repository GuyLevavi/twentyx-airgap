# Git holds TEXT ONLY. Everything binary is computed by Nix, not committed:
# the closure IS the manifest, so there is no blob list to keep in sync.
dist/
build/
result
result-*
node_modules/
*.log
.DS_Store

# An accidental drop at the root; the repo's copies live in env/.
/ca-bundle.crt

# opencode skips its startup npm install (a ~1.5 min stall offline) when this
# directory exists beside a lock naming @opencode-ai/plugin; the .keep holds it.
!dotfiles/.config/opencode/node_modules/
