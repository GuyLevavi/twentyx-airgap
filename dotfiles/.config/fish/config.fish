# ~/.config/fish/config.fish -- a symlink into the toolchain tree; edit it
# in the repo (or through this path) and commit to share.

# Runtime environment generated by bootstrap in a pod (HOME relocation, XDG,
# caches, injected CA/pip). Absent on WSL, where the system sets these.
if test -f /opt/twentyx/etc/env.fish
    source /opt/twentyx/etc/env.fish
end

# opencode's provider/update traffic goes through the internal endpoints and
# Node's trust is stricter than the system bundle; opt the check out.
set -gx NODE_TLS_REJECT_UNAUTHORIZED 0

set -g fish_greeting

# A remote emulator may announce a TERM with no terminfo entry; clamp it to a
# safe 256-colour entry rather than degrade to a monochrome fallback.
if not infocmp $TERM >/dev/null 2>&1
    set -gx TERM xterm-256color
end

# Loud until the per-site provider/model edit is done. The config is a real
# file on the durable home; edit it in place, no rebuild.
if test -f "$HOME/.config/opencode/opencode.jsonc"; and string match -q -- '*AIRGAP-SETUP*' < "$HOME/.config/opencode/opencode.jsonc"
    echo "WARNING: $HOME/.config/opencode/opencode.jsonc still has the AIRGAP-SETUP placeholder -- set the internal provider/model (next opencode start, no rebuild)." >&2
end

if status is-interactive
    # Land every interactive shell in a persistent session; skip when
    # already inside tmux.
    if not set -q TMUX
        exec tmux new-session -A -s main
    end

    abbr --add -- g git
    abbr --add -- lg lazygit
    abbr --add -- ll 'eza -l --icons --git'
    abbr --add -- lt 'eza --tree --icons --level=2'
    command -q kubectl; and abbr --add -- k kubectl

    alias cat 'bat -p'
    alias ls 'eza --icons --group-directories-first'
    alias tldr 'tldr --quiet'

    fzf --fish | source
    zoxide init fish | source
    if test "$TERM" != dumb
        starship init fish | source
    end
    atuin init fish | source
    direnv hook fish | source
end
