# ~/.config/fish/config.fish: DO NOT EDIT -- this file has been generated
# automatically by home-manager.

# Only execute this file once per shell.
set -q __fish_home_manager_config_sourced; and exit
set -g __fish_home_manager_config_sourced 1

source /nix/store/hdw6yfgv9zb7w2ksi65nkf9bv1vvj0f8-hm-session-vars.fish/etc/profile.d/hm-session-vars.fish

# Source handler functions

if test "$HOME" != /home/jensen
    for var in (set --names --export)
        if string match -q -- '*/home/jensen*' $$var
            set -gx $var (string replace -a -- /home/jensen "$HOME" $$var) 2>/dev/null
        end
    end
end

# The fish half of libexec/airgap-limits.sh, for a fish started directly
# (`runai exec -- fish`) rather than exec'd from bash, which already set
# these. Builtins only; fills what is unset.
if not set -q OMP_NUM_THREADS; and test -r /sys/fs/cgroup/cpu.max
    read -l __q __p </sys/fs/cgroup/cpu.max
    if test "$__q" != max
        set -l __n (math "max(1, ceil($__q / $__p))")
        set -q AIRGAP_THREADS; and set __n $AIRGAP_THREADS
        set -gx AIRGAP_CPUS $__n
        for __v in OMP_NUM_THREADS MKL_NUM_THREADS OPENBLAS_NUM_THREADS NUMEXPR_NUM_THREADS NUMEXPR_MAX_THREADS RAYON_NUM_THREADS GOMAXPROCS
            set -q $__v; or set -gx $__v $__n
        end
    end
end

status is-login; and begin

    # Login shell initialisation

end

status is-interactive; and begin

    # Abbreviations
    abbr --add -- g git
    abbr --add -- k kubectl
    abbr --add -- lg lazygit
    abbr --add -- ll 'eza -l --icons --git'
    abbr --add -- lt 'eza --tree --icons --level=2'

    # Aliases
    alias cat 'bat -p'
    alias la 'eza -a'
    alias ll 'eza -l'
    alias lla 'eza -la'
    alias ls 'eza --icons --group-directories-first'
    alias lt 'eza --tree'
    alias tldr 'tldr --quiet'

    # Interactive shell initialisation
    /nix/store/a6yq1vjmqhwy5vw11mn3mrh9crzg7jxf-fzf-0.74.3/bin/fzf --fish | source

    set -g fish_greeting

    # In a pod the emulator is remote and TERM arrives from the client.
    # WezTerm announces TERM=wezterm, whose terminfo we ship; anything we do
    # not recognise is clamped to a safe 256-colour entry rather than left to
    # degrade into a monochrome fallback.
    if not infocmp $TERM >/dev/null 2>&1
        set -gx TERM xterm-256color
    end

    # Second half of the rehome (see shellInit for the first). Deferred to
    # the first prompt because fish_complete_path is assigned further down
    # home-manager's config.fish, after this block: a rewrite running here
    # would miss the one value it is here to fix.
    if test "$HOME" != /home/jensen
        function __airgap_rehome --on-event fish_prompt
            functions --erase __airgap_rehome
            set -g fish_complete_path (string replace -a -- /home/jensen "$HOME" $fish_complete_path)
        end
    end

    /nix/store/hy2dl1cpdci8sjknm29cb037ss0h9jr7-zoxide-0.10.0/bin/zoxide init fish | source

    if test "$TERM" != dumb
        /nix/store/3wdc01px7pmymg4ry03gfgkm75phyd45-starship-1.26.0/bin/starship init fish | source

    end

    # add completions generated by Home Manager to $fish_complete_path
    begin
        set -l joined (string join " " $fish_complete_path)
        set -l prev_joined (string replace --regex "[^\s]*generated_completions.*" "" $joined)
        set -l post_joined (string replace $prev_joined "" $joined)
        set -l prev (string split " " (string trim $prev_joined))
        set -l post (string split " " (string trim $post_joined))
        set fish_complete_path $prev "/home/jensen/.local/share/fish/home-manager/generated_completions" $post
    end

    source /nix/store/zw4gffin8hhw7z3fnjn1r9m11zardyxd-atuin-fish-config.fish

    if not functions -q __direnv_export_eval
        /nix/store/q5s6iq0gqysmb2r76mkyxixkd2a9yk3p-direnv-2.37.1/bin/direnv hook fish | source
    end

end
