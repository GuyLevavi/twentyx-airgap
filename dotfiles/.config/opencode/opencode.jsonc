{
  "$schema": "https://opencode.ai/config.json",
  // AIRGAP-SETUP: point opencode at the internal endpoint before first use.
  // $HOME/.config/opencode/opencode.jsonc links into the repo: edit it, commit;
  // the next opencode start picks it up, no rebuild. Typical shape (ask the
  // cluster owner for the exact provider, model and baseURL):
  //
  //   "model": "<provider>/<model>",
  //   "provider": {
  //     "<provider>": {
  //       "npm": "@ai-sdk/openai-compatible",
  //       "name": "<label>",
  //       "options": { "baseURL": "https://<internal-host>/v1" }
  //     }
  //   }
  //
  // Delete this AIRGAP-SETUP block once configured; the interactive shell
  // warns while it is present.

  // Binary-coupled pieces from the closure, at stable paths a transfer
  // updates in place: the vendored skills, and workmux's status plugin (same
  // revision as the workmux binary). preload.ts sits in plugins/ beside this.
  "skills": { "paths": ["/opt/twentyx/home-defaults/.config/opencode/skills"] },
  "plugin": ["/opt/twentyx/home-defaults/.config/opencode/plugins/workmux-status.ts"],
  "lsp": {
    "pyright": { "disabled": true },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    }
  }
}
