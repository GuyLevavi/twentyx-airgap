{
  "agent": {
    "agent_buffer_font_size": 16,
    "button": false,
    "dock": "right",
    "sidebar_side": "right",
    "tool_permissions": {
      "default": "allow"
    }
  },
  "agent_servers": {
    "OpenCode": {
      "args": [
        "acp"
      ],
      "command": "opencode",
      "type": "custom"
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "format_on_save": "on",
  "git_panel": {
    "button": false,
    "dock": "right"
  },
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "Nix": {
      "language_servers": [
        "nixd",
        "!nil"
      ]
    },
    "Python": {
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "language_servers": [
        "basedpyright",
        "!pyright",
        "ruff"
      ]
    }
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "project_panel": {
    "button": false,
    "dock": "right"
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "system"
  },
  "ui_font_size": 18,
  "vim_mode": true,
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  }
}
