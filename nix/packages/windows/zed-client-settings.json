// Zed settings for the airgap Windows client — shipped in .#windows-kit.
//
// Copy to %APPDATA%\Zed\settings.json (merge into an existing file if you
// have one; a real file always wins, which is why this cannot be pushed).
// Everything here exists to keep the editor honest in the gap:
//   - auto_update off: the client must stay at the kit installer's version,
//     because the WSL side ships its remote server under that exact string.
//   - telemetry off: no phone-home attempts to time out against.
//   - no auto_install_extensions: the kit vendors the extensions into
//     %LOCALAPPDATA%\Zed\extensions\installed and UNPACK.ps1 puts them there.
// The WSL-side settings (~/.config/zed/settings.json, seeded once) carry the
// language-server pins; this file only needs the client bits.
{
  "wsl_connections": [
    {
      "distro_name": "twentyx",
      "user": null,
      "projects": [
        {
          "paths": [
            "/home/jensen"
          ]
        }
      ]
    }
  ],
  "auto_update": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte"
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "ui_font_size": 18,
  "format_on_save": "on",
  // Everything docks right; panels are keyboard toggles, so the status-bar
  // buttons stay hidden.
  "project_panel": {
    "dock": "right",
    "button": false
  },
  "git_panel": {
    "dock": "right",
    "button": false
  },
  "outline_panel": {
    "dock": "right",
    "button": false
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "agent": {
    "dock": "right",
    "button": false,
    "sidebar_side": "right",
    // Auto-approve agent tool calls; font matches buffer_font_size.
    "tool_permissions.default": "allow",
    "agent_buffer_font_size": 16,
    // Terminal Threads (agent panel -> New Thread -> Terminal) start opencode
    // immediately, as a TUI instead of ACP.
    "terminal_init_command": "opencode"
  },
  // Hold a combo briefly to see available follow-up keys.
  "which_key": {
    "enabled": true,
    "delay_ms": 500
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  }
}
