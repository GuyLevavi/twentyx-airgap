#!/usr/bin/env bash
# Summary: rebuild $HOME from packaged defaults + persistent overrides
#
# Idempotent. Safe to run repeatedly: at pod start, after `airgap update`, or
# by hand. Everything it creates in $HOME is a symlink, so $HOME stays
# disposable by design and nothing of value can be lost when the pod dies.
set -euo pipefail

AIRGAP_ROOT="${AIRGAP_ROOT:-/opt/airgap}"
. "$AIRGAP_ROOT/libexec/airgap-common.sh"

STATE="$(airgap_state)"
export AIRGAP_STATE="$STATE"

mkdir -p "$STATE"/{config,pi,share,cache,projects}

# --- bash -----------------------------------------------------------------
# .bashrc is a small generated stub that sources the drop-in dirs. Users edit
# $STATE/config/bashrc.d/*.sh, which survives restarts and wins on ordering.
mkdir -p "$STATE/config/bashrc.d"
cat > "$HOME/.bashrc" <<EOF
# Generated by airgap-bootstrap. Do not edit; changes are lost on restart.
# Put your customizations in \$AIRGAP_STATE/config/bashrc.d/*.sh
export AIRGAP_ROOT="$AIRGAP_ROOT"
export AIRGAP_STATE="$STATE"
for f in "$AIRGAP_ROOT"/config/bashrc.d/*.sh; do [ -r "\$f" ] && . "\$f"; done
for f in "$STATE"/config/bashrc.d/*.sh;      do [ -r "\$f" ] && . "\$f"; done
EOF
# Login shells must pick this up too; vscode-server terminals vary.
grep -qs 'bashrc' "$HOME/.bash_profile" 2>/dev/null || \
    echo '[ -r ~/.bashrc ] && . ~/.bashrc' > "$HOME/.bash_profile"

# --- config files: default, unless the user has an override ---------------
# $STATE wins over $AIRGAP_ROOT. This is what makes `airgap refresh` meaningful:
# deleting the override falls back to the packaged default.
overlay() {
    local rel="$1" dst="$HOME/$2"
    if [ -e "$STATE/config/$rel" ]; then link_into "$STATE/config/$rel" "$dst"
    else                                 link_into "$AIRGAP_ROOT/config/$rel" "$dst"; fi
}
overlay starship.toml   .config/starship.toml
overlay tmux.conf       .tmux.conf
overlay nvim            .config/nvim
overlay git/config      .config/git/config

# --- persistent, mutable state --------------------------------------------
# These must be real directories on the PVC, not links into the image.
link_into "$STATE/share"          "$HOME/.local/share"
link_into "$STATE/cache"          "$HOME/.cache"

# --- pi -------------------------------------------------------------------
# Sessions and auth belong on the PVC; resources come from the image.
mkdir -p "$STATE/pi"/{sessions,agents,extensions}
link_into "$STATE/pi" "$HOME/.pi/agent"
for r in agents prompts skills; do
    [ -d "$AIRGAP_ROOT/pi/$r" ] || continue
    mkdir -p "$STATE/pi/$r"
    for f in "$AIRGAP_ROOT/pi/$r"/*; do
        [ -e "$f" ] && link_into "$f" "$STATE/pi/$r/$(basename "$f")"
    done
done
[ -f "$STATE/pi/settings.json" ] || cp "$AIRGAP_ROOT/config/pi/settings.json" "$STATE/pi/settings.json"
[ -f "$STATE/pi/models.json" ]   || cp "$AIRGAP_ROOT/config/pi/models.json"   "$STATE/pi/models.json"

# --- code-server: seed baked extensions onto the PVC ----------------------
# code-server needs its extensions dir WRITABLE (it writes state and lets you
# install more), so the baked copy is seeded once rather than symlinked. After
# that the PVC copy wins and survives restarts, including anything you add by
# hand. Delete the dir to re-seed from the image on next start.
CS_EXT="$STATE/share/code-server/extensions"
if [ -d "$AIRGAP_ROOT/vscode-extensions" ] && [ ! -d "$CS_EXT" ]; then
    mkdir -p "$CS_EXT"
    cp -r "$AIRGAP_ROOT/vscode-extensions/." "$CS_EXT/" 2>/dev/null || true
fi

# --- neovim: seed the offline plugin pack ---------------------------------
# LazyVim must never resolve a plugin from the network. The pack is copied (not
# linked) on first run so lazy.nvim can write its lockfile alongside it.
if [ -d "$AIRGAP_ROOT/nvim-pack" ] && [ ! -d "$STATE/share/nvim/lazy" ]; then
    mkdir -p "$STATE/share/nvim"
    cp -r "$AIRGAP_ROOT/nvim-pack" "$STATE/share/nvim/lazy"
fi

exit 0
