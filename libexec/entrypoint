#!/usr/bin/env bash
# Container entrypoint -- materialize $HOME, register the runtime user, exec
# the payload.
#
# $HOME is relocated onto the PVC by bootstrap, so what survives a
# restart is everything rather than a hand-maintained list. Two layers:
#
#   $TOOLCHAIN_ROOT/home-defaults   packaged defaults, symlinks into /nix/store
#   $HOME (on the PVC)           real files, which are user overrides
#
# A default is a symlink into the store, an override is a real file; bootstrap
# never touches the latter.
set -euo pipefail

TOOLCHAIN_ROOT="${TOOLCHAIN_ROOT:-/opt/twentyx}"
. "$TOOLCHAIN_ROOT/libexec/common.sh"

"$TOOLCHAIN_ROOT/libexec/bootstrap" || warn "bootstrap incomplete, continuing"

# Bootstrap runs as a CHILD, so its exports die with it -- and for an arbitrary
# UID with no passwd entry the runtime itself sets HOME=/ (observed). Resolve
# here, in this process, so everything exec'd below -- the base entrypoint,
# code-server, `runai exec` payloads -- inherits the relocated $HOME. This is
# the same resolution doctor does; the two must agree by construction.
HOME="$(session_home)"
export HOME
mkdir -p "$HOME" 2>/dev/null || true

# Environment-provided assets (internal CA, pip.conf) for everything exec'd
# below -- code-server and friends never source a shell rc, and this is the
# last point where pod-wide env can be set. (`runai exec` payloads are a CRI
# exec: they get image ENV only, which is why the launcher re-resolves too.)
apply_injection_exports

# OpenShift runs us under an arbitrary UID (observed: uid 10001, gid 0, plus a
# nameless supplementary group such as 1001650000) with no /etc/passwd or
# /etc/group entry. Symptoms: `groups: cannot find name for group id 1001650000`
# on every shell start, and git/ssh/starship failing to resolve the user.
#
# Root privileges come from the repo layer's /etc/sudoers (gid 0 gets
# passwordless sudo); this self-registration is about the shell noise and
# tools that insist on a passwd entry. If /etc is not writable we degrade
# quietly rather than fail.
UID_NOW="$(id -u)"
if ! getent passwd "$UID_NOW" >/dev/null 2>&1 && [ -w /etc/passwd ]; then
    printf '%s:x:%s:0:workspace user:%s:/bin/bash\n' \
        "${USERNAME:-jensen}" "$UID_NOW" "$HOME" >> /etc/passwd
fi

# Name every supplementary group we hold, which is what silences
# `groups: cannot find name for group id ...` at shell start.
if [ -w /etc/group ]; then
    for g in $(id -G 2>/dev/null); do
        getent group "$g" >/dev/null 2>&1 && continue
        printf 'workspace-%s:x:%s:\n' "$g" "$g" >> /etc/group
    done
fi

# Hand over. With arguments (`runai exec ... -- cmd`) we run them; without,
# we defer to whatever the BASE image was going to run.
#
# That fallback is why assemble.sh records BASE_ENTRYPOINT: replacing
# ENTRYPOINT is how this script gets to run at all, but on the vscode-* bases
# the thing it replaced was the code-server launcher. Discarding it would give
# you a workspace whose IDE never starts.
if [ "$#" -ne 0 ]; then
    exec "$@"
fi

if [ -n "${BASE_ENTRYPOINT:-}" ]; then
    # Deliberately word-split: the value is a command line captured from the
    # image config, not a filename.
    # shellcheck disable=SC2086
    exec ${BASE_ENTRYPOINT}
fi

exec /bin/bash -l
