#!/usr/bin/env bash
# Seed $HOME from the toolchain tree.
#
#   seed-home
#
# 1. Refresh every packaged default (a store symlink) into $HOME.
# 2. Symlink every dotfile to its toolchain copy, so a text-layer update
#    renews it. A real file is the user's and is never clobbered.
# 3. Replace stale home-manager-era links (dangling, or *-home-manager-files).
# 4. Adopt an unmodified real copy as a link; report an edited one whose
#    shipped default has moved on.
#
# Run by bootstrap in a pod and by a user service on WSL. Idempotent.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOLCHAIN_ROOT="${TOOLCHAIN_ROOT:-/opt/twentyx}"
DEFAULTS="${HOME_DEFAULTS:-$TOOLCHAIN_ROOT/home-defaults}"
DOTFILES="${DOTFILES_DIR:-$ROOT/dotfiles}"
HOME="${HOME:?seed-home: HOME must be set}"

# A checkout is the live text tree: prefer it over the /opt copy, so clone
# edits are live without a closure rebuild (a stale unit from an older
# closure still runs this script from /opt).
if [ "$ROOT" = "$TOOLCHAIN_ROOT" ] && [ -x "$HOME/twentyx/libexec/seed-home" ]; then
    exec "$HOME/twentyx/libexec/seed-home"
fi

say() { printf '\033[36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$*" >&2; }

# A home-manager-era symlink is ours: it points into the store at the old
# *-home-manager-files tree, or at a store path this image no longer carries.
hm_era_link() {
    [ -L "$1" ] || return 1
    local t
    t="$(readlink "$1")"
    case "$t" in
        /nix/store/*)
            [ -e "$1" ] || return 0
            case "$t" in *-home-manager-files/*) return 0 ;; esac
            ;;
    esac
    return 1
}

# find does not descend into a symlinked starting point; home-defaults is a
# store symlink in a pod.
if [ -e "$DEFAULTS" ]; then
    DEFAULTS="$(readlink -f "$DEFAULTS")"
fi

# ── 1. packaged defaults: refresh symlinks, never touch a real file ───────
if [ -d "$DEFAULTS" ]; then
    while IFS= read -r src; do
        rel="${src#"$DEFAULTS"/}"
        [ "$rel" = "$src" ] && { warn "skipping unstrippable default: $src"; continue; }
        case "$rel" in .cache/*) continue ;; esac
        tgt="$(readlink -f "$src")"
        dst="$HOME/$rel"
        mkdir -p "$(dirname "$dst")"
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$tgt" ] || { rm -f "$dst"; ln -s "$tgt" "$dst"; }
        elif [ -e "$dst" ]; then
            : # a real file: the user's, never clobbered
        else
            ln -s "$tgt" "$dst"
        fi
    done < <(find "$DEFAULTS" \( -type f -o -type l \) 2>/dev/null)
else
    warn "$DEFAULTS missing -- is the Nix layer present?"
fi

# ── 2. dotfiles: managed symlinks into the toolchain tree ────────────────
if [ -d "$DOTFILES" ]; then
    while IFS= read -r src; do
        rel="${src#"$DOTFILES"/}"
        [ "$rel" = "$src" ] && continue
        dst="$HOME/$rel"
        if hm_era_link "$dst"; then rm -f "$dst"; fi
        # A dangling link (e.g. the old live symlink into the repo) has no
        # content and is never the user's file.
        if [ -L "$dst" ] && [ ! -e "$dst" ]; then rm -f "$dst"; fi
        if [ -L "$dst" ]; then
            [ "$(readlink "$dst")" = "$src" ] || { rm -f "$dst"; ln -s "$src" "$dst"; }
            continue
        fi
        if [ -e "$dst" ]; then
            # A real file is the user's. An identical copy is adopted as a
            # link (the pre-symlink migration); an edited one stays.
            # sha256sum over cmp: coreutils is on every caller's PATH.
            if [ "$(sha256sum < "$src")" = "$(sha256sum < "$dst")" ]; then
                rm -f "$dst"
            else
                printf 'newer default available: diff %s %s\n' "$src" "$dst"
                continue
            fi
        fi
        mkdir -p "$(dirname "$dst")"
        ln -s "$src" "$dst"
    done < <(find "$DOTFILES" -type f)
else
    warn "$DOTFILES missing"
fi

say "home seeded from $DOTFILES and $DEFAULTS"
