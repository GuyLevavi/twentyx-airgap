#!/usr/bin/env bash
# Summary: verify vendored blobs against CHECKSUMS.sha256
#
#   airgap-vendor-verify <dir> [checksums-file]
#
# Two checksums exist, for two different jobs. Do not conflate them:
#
#   manifest.toml sha256    upstream ARCHIVE hash. Checked OUTSIDE by
#                           fetch-vendor.sh -- "did I download what upstream published?"
#
#   CHECKSUMS.sha256        EXTRACTED FILE hashes, generated by fetch-vendor.sh
#                           over exactly what gets packed. Checked INSIDE at
#                           build time -- "did the physical transfer corrupt anything?"
#
# The archive hash cannot answer the second question: by build time the archive
# is gone and only the extracted binaries remain.
#
# This uses `sha256sum -c` rather than parsing TOML, because the build path is
# the last place to want a hand-rolled parser.
set -euo pipefail

DIR="${1:?usage: airgap-vendor-verify <dir> [checksums-file]}"
SUMS="${2:-$DIR/CHECKSUMS.sha256}"

[ -d "$DIR" ] || { echo "no such dir: $DIR" >&2; exit 1; }

if [ ! -f "$SUMS" ]; then
    echo "no checksums file: $SUMS" >&2
    echo "the vendor tarball is incomplete -- regenerate with scripts/fetch-vendor.sh" >&2
    exit 1
fi

echo "==> verifying $(grep -c . "$SUMS") artifact(s) against $(basename "$SUMS")"
if ( cd "$DIR" && sha256sum -c --quiet "$(realpath --relative-to="$DIR" "$SUMS" 2>/dev/null || echo "$SUMS")" ); then
    echo "vendor verification passed"
else
    cat >&2 <<'EOF'

vendor verification FAILED.

A mismatch here means the bytes changed between packing outside and unpacking
inside -- a truncated or corrupted physical transfer. Do not "fix" it by
regenerating the checksums; retransfer the tarball and check its .sha256 first.
EOF
    exit 1
fi
